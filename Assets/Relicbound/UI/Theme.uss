/* RELICBOUND — tema de interfaz (docs/04 §Tokens). Medidas a 1080 p de referencia. */
:root {
    --night: #14213D;
    --night-deep: #0B1324;
    --stone: #2B2A2E;
    --gold: #C9A54C;
    --gold-light: #E9CC78;
    --positive: #4E9A51;
    --danger: #D6605A;
    --text: #F3EAD8;
    --text-dim: #B9AF9C;
    -unity-font: url("Fonts/NunitoSans-SemiBold.ttf");
    -unity-font-definition: initial;
    color: var(--text);
    font-size: 24px;
}

.screen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.hidden { display: none; }
.overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; }
.fade { transition-property: opacity; transition-duration: 0.45s; transition-timing-function: ease-in-out; }
.transparent { opacity: 0; }

/* ---------------------------------------------------------------- tipografía */
.title {
    -unity-font: url("Fonts/Cinzel-Bold.ttf");
    -unity-font-definition: initial;
    font-size: 40px;
    color: var(--gold-light);
    -unity-text-align: middle-center;
    text-shadow: 0 3px 3px rgba(0, 0, 0, 0.6);
    letter-spacing: 2px;
}
.subtitle { font-size: 22px; color: var(--text-dim); -unity-text-align: middle-center; }
.field-label { font-size: 20px; color: var(--text-dim); margin-top: 18px; margin-bottom: 6px; letter-spacing: 1px; }
.hint { font-size: 18px; color: var(--text-dim); min-height: 26px; margin-top: 4px; }
.hint--error { color: var(--danger); }
.number { -unity-font: url("Fonts/NunitoSans-ExtraBold.ttf"); -unity-font-definition: initial; }

/* ---------------------------------------------------------------- superficies */
.panel {
    background-image: url("Textures/ui_panel.png");
    -unity-slice-left: 28; -unity-slice-right: 28; -unity-slice-top: 28; -unity-slice-bottom: 28;
    padding: 36px 44px;
}
.card {
    background-image: url("Textures/ui_card.png");
    -unity-slice-left: 16; -unity-slice-right: 16; -unity-slice-top: 16; -unity-slice-bottom: 16;
    padding: 10px 16px;
}
.divider {
    background-image: url("Textures/ui_divider.png");
    height: 24px;
    width: 80%;
    align-self: center;
    margin: 10px 0;
    -unity-background-scale-mode: scale-to-fit;
}
.vignette {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-image: url("Textures/ui_vignette.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* ---------------------------------------------------------------- botones */
.primary-button, .secondary-button {
    -unity-font: url("Fonts/Cinzel-Bold.ttf");
    -unity-font-definition: initial;
    font-size: 26px;
    color: var(--text);
    text-shadow: 0 2px 2px rgba(0, 0, 0, 0.55);
    min-height: 72px;
    padding: 0 40px;
    margin: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-slice-left: 20; -unity-slice-right: 20; -unity-slice-top: 20; -unity-slice-bottom: 20;
    transition-property: scale; transition-duration: 0.08s;
}
.primary-button { background-image: url("Textures/ui_button_primary.png"); }
.primary-button:hover { -unity-background-image-tint-color: #E8FFE4; }
.primary-button:active { background-image: url("Textures/ui_button_primary_pressed.png"); scale: 0.97 0.97; }
.primary-button:disabled { background-image: url("Textures/ui_button_disabled.png"); color: #9C9890; opacity: 1; }
.secondary-button { background-image: url("Textures/ui_button_secondary.png"); }
.secondary-button:hover { -unity-background-image-tint-color: #E6ECFF; }
.secondary-button:active { scale: 0.97 0.97; }

.round-button {
    width: 76px; height: 76px;
    padding: 16px;
    margin: 0 0 0 12px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("Textures/ui_button_round.png");
    transition-property: scale; transition-duration: 0.08s;
}
.round-button:hover { -unity-background-image-tint-color: #E6ECFF; }
.round-button:active { scale: 0.94 0.94; }

.icon-button {
    width: 56px; height: 56px; padding: 14px; margin: 0;
    border-width: 0; background-color: rgba(0, 0, 0, 0);
}

/* ---------------------------------------------------------------- campos */
.field { margin: 0; }
.field > .unity-text-field__input, .field .unity-base-text-field__input {
    background-image: url("Textures/ui_field.png");
    -unity-slice-left: 14; -unity-slice-right: 14; -unity-slice-top: 14; -unity-slice-bottom: 14;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    min-height: 62px;
    padding: 0 18px;
    font-size: 26px;
    color: var(--text);
    -unity-font: url("Fonts/NunitoSans-ExtraBold.ttf");
    -unity-font-definition: initial;
}
.field:focus > .unity-text-field__input, .field:focus .unity-base-text-field__input { background-image: url("Textures/ui_field_focus.png"); }
.field--error > .unity-text-field__input, .field--error .unity-base-text-field__input { background-image: url("Textures/ui_field_error.png"); }

/* ---------------------------------------------------------------- splash */
.splash { background-color: var(--night-deep); align-items: center; justify-content: center; }
.logo { align-items: center; }
.logo-title {
    -unity-font: url("Fonts/Cinzel-Bold.ttf");
    -unity-font-definition: initial;
    font-size: 124px;
    letter-spacing: 14px;
    color: var(--gold-light);
    text-shadow: 0 6px 8px rgba(0, 0, 0, 0.7);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #6E5320;
}
.logo-sub {
    -unity-font: url("Fonts/Cinzel-Bold.ttf");
    -unity-font-definition: initial;
    font-size: 34px;
    letter-spacing: 18px;
    color: var(--text);
    margin-top: 4px;
}
.logo .divider { width: 720px; }
.loading-track {
    position: absolute; bottom: 90px; width: 420px; height: 4px;
    background-color: rgba(201, 165, 76, 0.18);
}
.loading-fill { height: 4px; width: 0; background-color: var(--gold); }

/* ---------------------------------------------------------------- perfil */
.profile-card { width: 720px; }
.banner-choices { flex-direction: row; justify-content: center; margin-top: 4px; }
.banner-choice {
    width: 132px; height: 152px; margin: 0 14px; padding: 12px;
    background-image: url("Textures/ui_card.png");
    -unity-slice-left: 16; -unity-slice-right: 16; -unity-slice-top: 16; -unity-slice-bottom: 16;
    border-width: 0; background-color: rgba(0, 0, 0, 0);
    transition-property: scale, translate; transition-duration: 0.12s;
}
.banner-choice:hover { translate: 0 -3px; }
.banner-choice--selected { background-image: url("Textures/ui_field_focus.png"); scale: 1.06 1.06; }
.profile-card .primary-button { margin-top: 26px; }

/* ---------------------------------------------------------------- intro */
.letterbox { position: absolute; left: 0; right: 0; height: 110px; background-color: #05080F; }
.letterbox--top { top: 0; }
.letterbox--bottom { bottom: 0; }
.intro-card { position: absolute; bottom: 150px; width: 1100px; align-items: center; }
.intro-title {
    -unity-font: url("Fonts/Cinzel-Bold.ttf");
    -unity-font-definition: initial;
    font-size: 46px; color: var(--gold-light); letter-spacing: 4px;
    text-shadow: 0 3px 6px rgba(0, 0, 0, 0.85);
}
.intro-text {
    font-size: 30px; color: var(--text); -unity-text-align: middle-center; white-space: normal;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.9);
}
.skip-button { position: absolute; top: 132px; right: 48px; min-height: 56px; font-size: 22px; padding: 0 28px; }

/* ---------------------------------------------------------------- HUD */
.hud { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.hud-top { flex-direction: row; justify-content: space-between; align-items: flex-start; padding: 22px 28px; }
.profile-badge {
    flex-direction: row; align-items: center;
    background-image: url("Textures/ui_panel.png");
    -unity-slice-left: 28; -unity-slice-right: 28; -unity-slice-top: 28; -unity-slice-bottom: 28;
    padding: 12px 26px 14px 14px;
    min-width: 400px;
}
.badge-shield { width: 84px; height: 96px; margin-right: 16px; }
.badge-text { flex-grow: 1; }
.badge-name {
    -unity-font: url("Fonts/Cinzel-Bold.ttf");
    -unity-font-definition: initial;
    font-size: 28px; color: var(--gold-light);
}
.badge-castle { font-size: 19px; color: var(--text-dim); margin-bottom: 8px; }
.xp-bar {
    height: 24px;
    background-image: url("Textures/ui_bar_bg.png");
    -unity-slice-left: 10; -unity-slice-right: 10; -unity-slice-top: 10; -unity-slice-bottom: 10;
}
.xp-fill {
    position: absolute; left: 0; top: 0; bottom: 0; min-width: 20px;
    background-image: url("Textures/ui_bar_fill.png");
    -unity-slice-left: 10; -unity-slice-right: 10; -unity-slice-top: 10; -unity-slice-bottom: 10;
    transition-property: width; transition-duration: 0.5s;
}
.xp-label { position: absolute; left: 0; right: 0; top: -2px; font-size: 17px; -unity-text-align: middle-center; text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9); }
.level-label {
    position: absolute; left: 0; right: 0; top: 30px;
    -unity-font: url("Fonts/Cinzel-Bold.ttf");
    -unity-font-definition: initial;
    font-size: 30px; color: #FFF6DE; -unity-text-align: middle-center;
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.8);
}

.resources { flex-direction: row; align-items: center; margin-top: 10px; }
.resource-pill {
    flex-direction: row; align-items: center;
    background-image: url("Textures/ui_pill.png");
    -unity-slice-left: 24; -unity-slice-right: 24; -unity-slice-top: 24; -unity-slice-bottom: 24;
    height: 56px; min-width: 170px; margin: 0 7px; padding: 0 22px 0 4px;
}
.resource-icon { width: 64px; height: 64px; margin: -6px 2px -6px -14px; -unity-background-scale-mode: scale-to-fit; }
.resource-value { font-size: 26px; flex-grow: 1; -unity-text-align: middle-right; }
.resource-pill--full { -unity-background-image-tint-color: #FFE08A; }
.resource-pill--full .resource-value { color: var(--gold-light); }

.hud-actions { flex-direction: row; margin-top: 4px; }

.building-panel {
    position: absolute; bottom: 30px; left: 50%; translate: -50% 0;
    width: 760px;
}
.building-header { flex-direction: row; align-items: center; justify-content: space-between; }
.building-name {
    -unity-font: url("Fonts/Cinzel-Bold.ttf");
    -unity-font-definition: initial;
    font-size: 34px; color: var(--gold-light);
}
.level-chip {
    background-image: url("Textures/ui_pill.png");
    -unity-slice-left: 24; -unity-slice-right: 24; -unity-slice-top: 24; -unity-slice-bottom: 24;
    padding: 4px 18px; margin-left: 14px; font-size: 20px; color: var(--gold-light);
}
.building-role { font-size: 20px; color: var(--text-dim); letter-spacing: 1px; }
.building-description { font-size: 22px; white-space: normal; margin-top: 6px; }
.building-stats { flex-direction: row; flex-wrap: wrap; margin-top: 14px; }
.stat { margin: 0 12px 0 0; flex-direction: row; align-items: center; }
.stat-label { font-size: 18px; color: var(--text-dim); margin-right: 8px; }
.stat-value { font-size: 22px; color: var(--text); }

/* ---------------------------------------------------------------- ajustes */
.modal { background-color: rgba(5, 8, 15, 0.55); }
.settings-card { width: 760px; }
.settings-header { flex-direction: row; align-items: center; justify-content: space-between; }
.setting-row { flex-direction: row; align-items: center; justify-content: space-between; min-height: 64px; }
.setting-name { font-size: 22px; width: 260px; }
.setting-control { flex-grow: 1; }
.setting-value { width: 70px; -unity-text-align: middle-right; color: var(--gold-light); }

.setting-control .unity-base-slider__tracker {
    background-color: #0C111C; border-color: #6E5A2E; border-width: 1px; border-radius: 6px; height: 12px; margin-top: -6px;
}
.setting-control .unity-base-slider__dragger {
    width: 30px; height: 30px; margin-top: -15px;
    background-color: var(--gold); border-color: #FFF0C0; border-width: 2px; border-radius: 15px;
}
.choice-row { flex-direction: row; }
.choice {
    min-height: 52px; padding: 0 22px; margin: 0 0 0 10px; font-size: 20px;
    -unity-font: url("Fonts/NunitoSans-ExtraBold.ttf");
    -unity-font-definition: initial;
    color: var(--text-dim); border-width: 0; background-color: rgba(0, 0, 0, 0);
    background-image: url("Textures/ui_card.png");
    -unity-slice-left: 16; -unity-slice-right: 16; -unity-slice-top: 16; -unity-slice-bottom: 16;
}
.choice--selected { background-image: url("Textures/ui_button_secondary.png"); -unity-slice-left: 20; -unity-slice-right: 20; -unity-slice-top: 20; -unity-slice-bottom: 20; color: var(--gold-light); }

/* ---------------------------------------------------------------- avisos */
.notice {
    position: absolute; top: 150px; left: 50%; translate: -50% 0;
    background-image: url("Textures/ui_panel.png");
    -unity-slice-left: 28; -unity-slice-right: 28; -unity-slice-top: 28; -unity-slice-bottom: 28;
    padding: 18px 36px; font-size: 24px; -unity-text-align: middle-center;
}
