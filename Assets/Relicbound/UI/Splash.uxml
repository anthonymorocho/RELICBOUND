<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Theme.uss" />
    <ui:VisualElement name="splash" class="screen splash">
        <ui:VisualElement name="logo" class="logo fade transparent">
            <ui:Label text="RELICBOUND" class="logo-title" />
            <ui:VisualElement class="divider" />
            <ui:Label text="SIEGE KINGDOMS" class="logo-sub" />
        </ui:VisualElement>
        <ui:VisualElement class="loading-track">
            <ui:VisualElement name="loading-fill" class="loading-fill" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
