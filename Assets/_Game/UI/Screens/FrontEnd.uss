/* BEFORE IT WAS YOU — estilo de interfaz. Referencia: Docs/Preproduccion/IMAGENES/01_moodboard_original.png */

.root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    -unity-font: url("project://database/Assets/_Game/UI/Fonts/Inter-Regular.ttf");
    -unity-font-definition: initial;
    color: rgb(233, 228, 218);
}

.layer {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

.hidden {
    display: none;
}

.fade {
    background-color: rgb(0, 0, 0);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.6s;
    transition-timing-function: ease-in-out-sine;
}

.fade--on {
    opacity: 1;
}

.scrim-left {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 1180px;
    background-image: url("project://database/Assets/_Game/UI/Textures/ui_scrim_left.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.scrim-bottom {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 360px;
    background-image: url("project://database/Assets/_Game/UI/Textures/ui_scrim_bottom.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.vignette {
    background-image: url("project://database/Assets/_Game/UI/Textures/ui_vignette.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* ---------- Menú principal ---------- */

.menu {
    position: absolute;
    left: 132px;
    top: 150px;
    width: 640px;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.7s, 0.7s;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}

.menu--away {
    opacity: 0;
    translate: -24px 0;
}

.title {
    -unity-font: url("project://database/Assets/_Game/UI/Fonts/BebasNeue-Regular.ttf");
    -unity-font-definition: initial;
    font-size: 138px;
    letter-spacing: 26px;
    color: rgb(238, 234, 226);
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
    text-shadow: 0 3px 14px rgba(0, 0, 0, 0.85);
}

.title--second {
    margin-top: -26px;
}

.accent-line {
    width: 560px;
    height: 4px;
    margin-top: 6px;
    background-image: url("project://database/Assets/_Game/UI/Textures/ui_accent_line.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.episode {
    -unity-font: url("project://database/Assets/_Game/UI/Fonts/Oswald-Light.ttf");
    -unity-font-definition: initial;
    font-size: 21px;
    letter-spacing: 7px;
    color: rgb(178, 172, 162);
    margin-top: 18px;
    padding: 0;
}

.episode--name {
    margin-top: 2px;
}

.menu-list {
    margin-top: 64px;
}

.menu-item {
    height: 58px;
    width: 520px;
    margin-bottom: 6px;
    padding-left: 24px;
    flex-direction: row;
    align-items: center;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    background-image: none;
    -unity-background-scale-mode: stretch-to-fill;
    transition-property: border-color, color;
    transition-duration: 0.15s;
}

.menu-item__label {
    -unity-font: url("project://database/Assets/_Game/UI/Fonts/Oswald-Regular.ttf");
    -unity-font-definition: initial;
    font-size: 29px;
    letter-spacing: 5px;
    color: rgb(214, 208, 198);
    padding: 0;
    margin: 0;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.9);
}

.menu-item--selected {
    background-image: url("project://database/Assets/_Game/UI/Textures/ui_menu_highlight.png");
    border-left-color: rgb(196, 38, 36);
}

.menu-item--selected > .menu-item__label {
    color: rgb(255, 252, 246);
}

.menu-item--disabled > .menu-item__label {
    color: rgb(110, 106, 100);
}

.menu-item__hint {
    -unity-font: url("project://database/Assets/_Game/UI/Fonts/Inter-Regular.ttf");
    -unity-font-definition: initial;
    font-size: 15px;
    color: rgb(160, 154, 146);
    margin-left: 18px;
    letter-spacing: 1px;
}

.footer {
    position: absolute;
    left: 132px;
    right: 96px;
    bottom: 54px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.footer__text {
    -unity-font: url("project://database/Assets/_Game/UI/Fonts/Inter-Regular.ttf");
    -unity-font-definition: initial;
    font-size: 15px;
    letter-spacing: 2px;
    color: rgb(128, 124, 118);
}

.keys {
    flex-direction: row;
    align-items: center;
}

.key {
    -unity-font: url("project://database/Assets/_Game/UI/Fonts/Inter-Medium.ttf");
    -unity-font-definition: initial;
    font-size: 14px;
    color: rgb(214, 208, 198);
    border-width: 1px;
    border-color: rgba(214, 208, 198, 0.55);
    border-radius: 3px;
    padding: 3px 8px;
    margin-left: 22px;
    margin-right: 8px;
    min-width: 30px;
    -unity-text-align: middle-center;
}

.key-label {
    -unity-font: url("project://database/Assets/_Game/UI/Fonts/Inter-Regular.ttf");
    -unity-font-definition: initial;
    font-size: 15px;
    color: rgb(170, 164, 156);
}

/* ---------- Paneles (opciones, créditos, confirmación) ---------- */

.panel {
    position: absolute;
    left: 132px;
    top: 120px;
    bottom: 140px;
    width: 980px;
    opacity: 1;
    transition-property: opacity, translate;
    transition-duration: 0.35s, 0.35s;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}

.panel--away {
    opacity: 0;
    translate: 0 14px;
}

.panel-title {
    -unity-font: url("project://database/Assets/_Game/UI/Fonts/Oswald-Regular.ttf");
    -unity-font-definition: initial;
    font-size: 54px;
    letter-spacing: 12px;
    color: rgb(240, 236, 228);
    margin: 0;
    padding: 0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.9);
}

.panel-subtitle {
    font-size: 17px;
    color: rgb(160, 154, 146);
    margin-top: 4px;
    margin-bottom: 26px;
}

.options-scroll {
    flex-grow: 1;
}

.section {
    -unity-font: url("project://database/Assets/_Game/UI/Fonts/Oswald-Medium.ttf");
    -unity-font-definition: initial;
    font-size: 17px;
    letter-spacing: 6px;
    color: rgb(196, 58, 52);
    margin-top: 26px;
    margin-bottom: 8px;
    padding-left: 24px;
}

.option-row {
    height: 52px;
    width: 900px;
    flex-direction: row;
    align-items: center;
    padding-left: 24px;
    padding-right: 20px;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
    -unity-background-scale-mode: stretch-to-fill;
}

.option-row--selected {
    background-image: url("project://database/Assets/_Game/UI/Textures/ui_menu_highlight.png");
    border-left-color: rgb(196, 38, 36);
}

.option-row__label {
    -unity-font: url("project://database/Assets/_Game/UI/Fonts/Inter-Regular.ttf");
    -unity-font-definition: initial;
    font-size: 21px;
    color: rgb(220, 214, 204);
    flex-grow: 1;
}

.option-row--selected > .option-row__label {
    color: rgb(255, 252, 246);
}

.option-row--action > .option-row__label {
    -unity-font: url("project://database/Assets/_Game/UI/Fonts/Oswald-Regular.ttf");
    -unity-font-definition: initial;
    font-size: 23px;
    letter-spacing: 4px;
}

.option-value {
    flex-direction: row;
    align-items: center;
    width: 380px;
    justify-content: flex-end;
}

.option-arrow {
    font-size: 20px;
    color: rgb(150, 144, 136);
    width: 36px;
    -unity-text-align: middle-center;
}

.option-row--selected .option-arrow {
    color: rgb(240, 236, 228);
}

.option-text {
    -unity-font: url("project://database/Assets/_Game/UI/Fonts/Inter-Medium.ttf");
    -unity-font-definition: initial;
    font-size: 20px;
    color: rgb(236, 232, 224);
    width: 250px;
    -unity-text-align: middle-center;
}

.slider {
    width: 220px;
    height: 6px;
    background-color: rgba(255, 255, 255, 0.14);
    margin-right: 16px;
}

.slider__fill {
    height: 6px;
    background-color: rgb(206, 200, 190);
}

.option-row--selected .slider__fill {
    background-color: rgb(214, 54, 50);
}

.slider-text {
    -unity-font: url("project://database/Assets/_Game/UI/Fonts/Inter-Medium.ttf");
    -unity-font-definition: initial;
    font-size: 19px;
    color: rgb(236, 232, 224);
    width: 64px;
    -unity-text-align: middle-right;
}

.option-static {
    -unity-font: url("project://database/Assets/_Game/UI/Fonts/Inter-Medium.ttf");
    -unity-font-definition: initial;
    font-size: 19px;
    color: rgb(200, 194, 184);
}

.description {
    position: absolute;
    left: 0;
    bottom: -84px;
    width: 900px;
    font-size: 17px;
    color: rgb(170, 164, 156);
    padding-left: 27px;
    white-space: normal;
}

.credits-body {
    font-size: 20px;
    color: rgb(214, 208, 198);
    white-space: normal;
    width: 860px;
}

.credits-heading {
    -unity-font: url("project://database/Assets/_Game/UI/Fonts/Oswald-Medium.ttf");
    -unity-font-definition: initial;
    font-size: 17px;
    letter-spacing: 6px;
    color: rgb(196, 58, 52);
    margin-top: 28px;
    margin-bottom: 6px;
}

.credits-line {
    font-size: 19px;
    color: rgb(214, 208, 198);
    white-space: normal;
    width: 860px;
    margin-bottom: 4px;
}

.credits-small {
    font-size: 15px;
    color: rgb(150, 144, 136);
    white-space: normal;
    width: 860px;
    margin-bottom: 3px;
}

/* ---------- Diálogo de confirmación ---------- */

.modal {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(3, 4, 6, 0.72);
    align-items: center;
    justify-content: center;
}

.modal__box {
    width: 760px;
    padding: 44px 52px 36px 52px;
    background-color: rgba(12, 13, 16, 0.96);
    border-left-width: 3px;
    border-left-color: rgb(196, 38, 36);
}

.modal__title {
    -unity-font: url("project://database/Assets/_Game/UI/Fonts/Oswald-Regular.ttf");
    -unity-font-definition: initial;
    font-size: 34px;
    letter-spacing: 6px;
    color: rgb(244, 240, 232);
}

.modal__text {
    font-size: 20px;
    color: rgb(190, 184, 174);
    margin-top: 14px;
    margin-bottom: 30px;
    white-space: normal;
}

.modal__buttons {
    flex-direction: row;
}

.modal__buttons > .menu-item {
    width: 300px;
    margin-right: 16px;
}

/* ---------- Pausa ---------- */

.pause {
    background-color: rgba(4, 5, 7, 0.62);
    align-items: center;
    justify-content: center;
}

.pause__title {
    -unity-font: url("project://database/Assets/_Game/UI/Fonts/Oswald-Light.ttf");
    -unity-font-definition: initial;
    font-size: 46px;
    letter-spacing: 16px;
    color: rgb(236, 232, 224);
    margin-bottom: 34px;
    -unity-text-align: middle-center;
}

.pause-item {
    width: 380px;
    height: 58px;
    margin-bottom: 12px;
    align-items: center;
    justify-content: center;
    background-color: rgba(18, 19, 23, 0.82);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.pause-item > .menu-item__label {
    font-size: 22px;
    letter-spacing: 5px;
}

.pause-item.menu-item--selected {
    background-image: none;
    background-color: rgba(42, 44, 50, 0.92);
    border-color: rgba(236, 232, 224, 0.55);
}

/* ---------- Prólogo y subtítulos ---------- */

.prologue {
    background-color: rgb(0, 0, 0);
    align-items: center;
    justify-content: center;
}

.grain {
    background-image: url("project://database/Assets/_Game/UI/Textures/ui_grain.png");
    -unity-background-scale-mode: scale-and-crop;
    opacity: 0.35;
}

.card {
    -unity-font: url("project://database/Assets/_Game/UI/Fonts/Oswald-Light.ttf");
    -unity-font-definition: initial;
    font-size: 26px;
    letter-spacing: 9px;
    color: rgb(200, 194, 184);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 1.2s;
    -unity-text-align: middle-center;
}

.card--on {
    opacity: 1;
}

.subtitles {
    position: absolute;
    left: 0; right: 0;
    bottom: 120px;
    align-items: center;
}

.subtitle {
    font-size: 30px;
    color: rgb(244, 240, 232);
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 1300px;
    padding: 6px 18px;
    background-color: rgba(0, 0, 0, 0.45);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.25s;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.9);
}

.subtitle--on {
    opacity: 1;
}

.skip-hint {
    position: absolute;
    right: 72px;
    bottom: 54px;
    flex-direction: row;
    align-items: center;
    opacity: 0.75;
}

/* ---------- HUD ---------- */

.hud {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

.crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    margin-top: -2px;
    border-radius: 2px;
    background-color: rgba(240, 236, 228, 0.55);
    transition-property: width, height, margin-left, margin-top, background-color;
    transition-duration: 0.12s;
}

.crosshair--focus {
    width: 8px;
    height: 8px;
    margin-left: -4px;
    margin-top: -4px;
    border-radius: 4px;
    background-color: rgba(250, 248, 242, 0.9);
}

.prompt {
    position: absolute;
    left: 0; right: 0;
    top: 56%;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.15s;
}

.prompt--on {
    opacity: 1;
}

.prompt__text {
    font-size: 19px;
    color: rgb(240, 236, 228);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 1);
}

.objective {
    position: absolute;
    left: 64px;
    top: 56px;
    padding: 12px 22px 14px 18px;
    border-left-width: 2px;
    border-left-color: rgb(214, 178, 92);
    background-color: rgba(8, 9, 11, 0.55);
    opacity: 0;
    translate: -10px 0;
    transition-property: opacity, translate;
    transition-duration: 0.6s, 0.6s;
}

.objective--on {
    opacity: 1;
    translate: 0 0;
}

.objective__label {
    -unity-font: url("project://database/Assets/_Game/UI/Fonts/Oswald-Medium.ttf");
    -unity-font-definition: initial;
    font-size: 15px;
    letter-spacing: 4px;
    color: rgb(214, 178, 92);
}

.objective__text {
    font-size: 19px;
    color: rgb(236, 232, 224);
    margin-top: 4px;
    max-width: 460px;
    white-space: normal;
}

.toast {
    position: absolute;
    right: 64px;
    bottom: 64px;
    flex-direction: row;
    align-items: center;
    padding: 12px 18px;
    background-color: rgba(10, 11, 14, 0.78);
    border-radius: 10px;
    opacity: 0;
    translate: 0 10px;
    transition-property: opacity, translate;
    transition-duration: 0.4s, 0.4s;
}

.toast--on {
    opacity: 1;
    translate: 0 0;
}

.toast__dot {
    width: 9px;
    height: 9px;
    border-radius: 5px;
    background-color: rgb(92, 196, 120);
    margin-right: 12px;
}

.toast__text {
    font-size: 17px;
    color: rgb(236, 232, 224);
}

/* ---------- Arranque ---------- */

.startup {
    background-color: rgb(0, 0, 0);
    align-items: center;
    justify-content: center;
}

.notice {
    width: 900px;
    align-items: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 1.1s;
}

.notice--on {
    opacity: 1;
}

.notice__title {
    -unity-font: url("project://database/Assets/_Game/UI/Fonts/Oswald-Regular.ttf");
    -unity-font-definition: initial;
    font-size: 22px;
    letter-spacing: 10px;
    color: rgb(196, 58, 52);
    margin-bottom: 22px;
}

.notice__text {
    font-size: 22px;
    color: rgb(214, 208, 198);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

.notice__text--soft {
    font-size: 18px;
    color: rgb(150, 144, 136);
    margin-top: 12px;
}
